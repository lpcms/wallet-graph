# ─────────────────────────────────────────────
# Etherscan API
# ─────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_CHAIN_ID=1

# Минимальный интервал между запросами к Etherscan в мс
# (бесплатный ключ — 3 запроса/с → 350мс; при платном тарифе можно уменьшить)
ETHERSCAN_INTERVAL_MS=350

# ─────────────────────────────────────────────
# Пагинация (обычный режим /graph/token/:address)
# PAGE_SIZE  — транзакций на страницу (макс. 1000 у Etherscan)
# MAX_PAGES  — сколько страниц качать в обычном режиме
# Итого: PAGE_SIZE × MAX_PAGES = макс. транзакций за запрос
# ─────────────────────────────────────────────
PAGE_SIZE=1000
MAX_PAGES=250

# ─────────────────────────────────────────────
# Полное сканирование (/graph/token/:address/full)
# FULL_PAGE_SIZE  — транзакций на страницу (макс. 1000)
# FULL_MAX_PAGES  — максимум страниц (0 = без ограничений)
# FULL_DELAY_MS   — задержка между запросами в мс
#                   (Etherscan: 3 req/s на бесплатном ключе → мин. 350мс)
# FULL_CACHE_TTL  — сколько держать данные в памяти (мс)
#                   3600000 = 1 час
# ─────────────────────────────────────────────
FULL_PAGE_SIZE=1000
FULL_MAX_PAGES=0
FULL_DELAY_MS=350
FULL_CACHE_TTL=3600000

# ─────────────────────────────────────────────
# Кэш обычного режима (мс)
# 300000 = 5 минут
# ─────────────────────────────────────────────
CACHE_TTL_MS=300000

# ─────────────────────────────────────────────
# Сервер
# ─────────────────────────────────────────────
PORT=3001

# ─────────────────────────────────────────────
# LSTM модель (шаг 4)
# LSTM_EPOCHS   — эпох обучения (меньше = быстрее, рекомендуется 8–15)
# LSTM_BATCH    — размер батча (больше = быстрее, рекомендуется 64–128)
# LSTM_LOOKBACK — окно свечей на вход (рекомендуется 20–40)
# LSTM_CANDLES  — свечей загружать с Binance (рекомендуется 500–1000)
# ─────────────────────────────────────────────
LSTM_EPOCHS=10
LSTM_BATCH=64
LSTM_LOOKBACK=30
LSTM_CANDLES=1000
