{
  "name": "api",
  "version": "1.0.0",
  "description": "Wallet Graph API: граф связей кошельков и токенов по данным Etherscan, кластеризация и прогноз цены",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "ts-node --transpile-only src/main.ts",
    "dev": "ts-node src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-tfjs-node.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "ccxt": "^4.5.48",
    "dotenv": "^17.3.1",
    "ml-kmeans": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
